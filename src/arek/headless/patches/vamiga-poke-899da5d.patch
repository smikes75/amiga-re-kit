+void vahl_reglog_record(u32 frame, u32 v, u32 h, u32 r, u16 value, u32 pc, bool agnusSrc)
+{
+    if (!vahl_reglog_wants(r)) return;
+    if (!vahl_reglog_probed) { vahl_reglog_probed = true; if (const char *p = getenv("VAHL_REGLOG")) vahl_reglog = fopen(p, "wb"); }
+    if (!vahl_reglog) return;
+    u32 rec[4] = { frame, (v << 16) | h, (r << 16) | value, (pc & 0xffffff) | (agnusSrc ? 0x1000000u : 0u) };
+    fwrite(rec, 4, 4, vahl_reglog);
+}
