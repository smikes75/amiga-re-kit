diff --git a/Core/Components/Agnus/VahlPoke.h b/Core/Components/Agnus/VahlPoke.h
new file mode 100644
index 0000000..dfa7c87
--- /dev/null
+++ b/Core/Components/Agnus/VahlPoke.h
@@ -0,0 +1,58 @@
+// VAHL_POKE=<file>: write into the memory of the running machine at a chosen moment and go on
+// (amiga-re-kit, arek trace run --poke). One poke per line:
+//   F <frame> <addr> <hex bytes>      when frame <frame> begins
+//   P <pc> <addr> <hex bytes>         at the first breakpoint hit at <pc> (set a breakpoint there)
+// <hex bytes> may be @<file> (the file's bytes). Memory::patch writes without bus cycles; each line
+// applies once. The record of what was written goes to stderr ("vahl poke ...").
+#pragma once
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace vahlpoke {
+
+struct Poke { char kind; long long when; unsigned addr; std::vector<unsigned char> bytes; bool done; };
+
+inline std::vector<Poke> &list()
+{
+    static std::vector<Poke> pokes;
+    static bool probed = false;
+    if (!probed) {
+        probed = true;
+        if (const char *p = std::getenv("VAHL_POKE")) {
+            std::ifstream in(p);
+            std::string line;
+            while (std::getline(in, line)) {
+                std::istringstream ss(line);
+                Poke k{}; std::string hex;
+                if (!(ss >> k.kind >> std::hex >> k.when >> k.addr >> hex)) continue;
+                if (k.kind != 'F' && k.kind != 'P') continue;
+                if (!hex.empty() && hex[0] == '@') {
+                    std::ifstream f(hex.substr(1), std::ios::binary);
+                    k.bytes.assign(std::istreambuf_iterator<char>(f), std::istreambuf_iterator<char>());
+                } else {
+                    for (size_t i = 0; i + 1 < hex.size(); i += 2)
+                        k.bytes.push_back((unsigned char)std::strtoul(hex.substr(i, 2).c_str(), nullptr, 16));
+                }
+                pokes.push_back(k);
+            }
+        }
+    }
+    return pokes;
+}
+
+template <typename Mem> inline void apply(Mem &mem, char kind, long long when, long long frame)
+{
+    for (auto &k : list()) {
+        if (k.done || k.kind != kind || k.when != when) continue;
+        k.done = true;
+        mem.patch(k.addr, k.bytes.data(), (long)k.bytes.size());
+        std::fprintf(stderr, "vahl poke %c %llx: %zu bytes at %06x (frame %lld)\n", kind, (unsigned long long)when,
+                     k.bytes.size(), k.addr, frame);
+    }
+}
+
+}
