+// VAHL_AUDLOG=<file>: every sample Paula sends to a channel output (penhi/penlo), 12 B: frame, v<<16|h, sample*volume<<16|channel.
+static FILE *vahl_audlog = nullptr; static bool vahl_audlog_probed = false;
+static void vahl_aud(u32 frame, u16 v, u16 h, i16 scaled, u16 nr)
+{
+    if (!vahl_audlog_probed) { vahl_audlog_probed = true; if (const char *p = getenv("VAHL_AUDLOG")) vahl_audlog = fopen(p, "wb"); }
+    if (!vahl_audlog) return;
+    u32 a = frame; u32 b = (u32(v) << 16) | h; u32 c = (u32(u16(scaled)) << 16) | nr;
+    fwrite(&a, 4, 1, vahl_audlog); fwrite(&b, 4, 1, vahl_audlog); fwrite(&c, 4, 1, vahl_audlog);
+}
