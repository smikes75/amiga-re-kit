+// VAHL_INPUTS=<file>: input per frame (line k = keys held: R L U D F S) applied at the k-th breakpoint hit in the VBL (v < 100)
+// sets joystick 2 and space (0x40) for frame k - frame exact, unlike 'wait 1 frames' in RetroShell.
+static std::vector<std::string> vahl_inputs; static bool vahl_inputs_probed = false; static size_t vahl_input_k = 0;
+static std::string vahl_prev_keys;
+static void vahl_apply_inputs(Amiga &amiga, u16 vpos)
+{
+    if (!vahl_inputs_probed) {
+        vahl_inputs_probed = true;
+        if (const char *p = getenv("VAHL_INPUTS")) { std::ifstream in(p); std::string line; while (std::getline(in, line)) vahl_inputs.push_back(line); }
+    }
+    static i64 lastFrame = -1;   // only the first hit of a frame (VBL); a copper interrupt high on the screen does not take an input line
+    if (vahl_inputs.empty() || vpos >= 100 || amiga.agnus.pos.frame == lastFrame) return;
+    lastFrame = amiga.agnus.pos.frame;
+    std::string k = vahl_input_k < vahl_inputs.size() ? vahl_inputs[vahl_input_k] : std::string(); vahl_input_k++;
+    auto &j = amiga.controlPort2.joystick;
+    bool r = k.find('R') != std::string::npos, l = k.find('L') != std::string::npos, u = k.find('U') != std::string::npos, d = k.find('D') != std::string::npos;
+    bool f = k.find('F') != std::string::npos, sp = k.find('S') != std::string::npos, spPrev = vahl_prev_keys.find('S') != std::string::npos;
+    j.trigger(r ? GamePadAction::PULL_RIGHT : l ? GamePadAction::PULL_LEFT : GamePadAction::RELEASE_X);
+    j.trigger(d ? GamePadAction::PULL_DOWN : u ? GamePadAction::PULL_UP : GamePadAction::RELEASE_Y);
+    bool fPrev = vahl_prev_keys.find('F') != std::string::npos;
+    if (f != fPrev) j.trigger(f ? GamePadAction::PRESS_FIRE : GamePadAction::RELEASE_FIRE);
+    if (sp && !spPrev) amiga.keyboard.press(KeyCode(0x40));
+    if (!sp && spPrev) amiga.keyboard.release(KeyCode(0x40));
+    vahl_prev_keys = k;
+}
