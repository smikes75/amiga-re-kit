+    // Turrican-projekt patch (WebAssembly): one frame synchronously, without
+    // the emulator thread. update() applies queued commands (RetroShell,
+    // config), computeFrame() runs one PAL frame. May throw when the core
+    // stops itself (breakpoint); the caller handles it like vAmigaWeb.
+    void stepFrame() { update(); computeFrame(); }
+    void stepFrameCommandsOnly() { update(); }
