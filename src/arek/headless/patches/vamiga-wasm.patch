+void
+Amiga::computeUntilLine(isize line)
+{
+    // Turrican-projekt (wasm): jako computeFrame, ale konci na zacatku radku `line`
+    // (vzorkovani RAM v okamziku copper preruseni hry). Konec snimku loop take ukonci.
+    while (agnus.pos.v < line) {
+
+        cpu.execute();
+        if (flags) {
+            // konec snimku (radek nedosazen): priznak spotrebovat jako computeFrame
+            if (flags & RL::SYNC_THREAD) { clearFlag(RL::SYNC_THREAD); break; }
+            break;   // breakpoint apod.: nechat zpracovat computeFrame
+        }
+    }
+}
+
 void
 Amiga::computeFrame()
 {
