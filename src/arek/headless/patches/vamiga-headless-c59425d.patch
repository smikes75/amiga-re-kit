@@ -183,6 +184,26 @@ Headless::process(Message msg)
             wakeUp();
             break;
 
+        case Msg::BREAKPOINT_REACHED:
+        case Msg::WATCHPOINT_REACHED:
+        case Msg::CATCHPOINT_REACHED:
+
+            // Turrican-projekt patch: when the emulator stops at a guard,
+            // run the RetroShell script named by VAHL_ONSTOP (dump regs,
+            // memory, ...). Commands are processed while paused.
+            if (const char *onstop = getenv("VAHL_ONSTOP")) {
+                std::cout << "ONSTOP " << MsgEnum::key(msg.type)
+                          << " pc=" << std::hex << (u32)msg.value
+                          << " aux=" << (u32)(msg.value >> 32) << std::dec << std::endl;
+                try {
+                    amiga->retroShell.abortScript();
+                    amiga->retroShell.execScript(fs::path(onstop));
+                } catch (std::exception &e) {
+                    std::cout << "ONSTOP error: " << e.what() << std::endl;
+                }
+            }
+            break;
+
         default:
             break;
     }
