diff --git a/Core/Components/Agnus/Agnus.cpp b/Core/Components/Agnus/Agnus.cpp
index 9010871..80915cc 100644
--- a/Core/Components/Agnus/Agnus.cpp
+++ b/Core/Components/Agnus/Agnus.cpp
@@ -109,6 +109,13 @@ Agnus::operator << (SerResetter &worker)
     // Remember some events
     auto insEvent = id[SLOT_INS];
 
+    // Turrican-projekt patch: RetroShell wakeups (the `wait` command) must
+    // survive a soft reset. Games that execute the 68000 RESET instruction
+    // (Turrican II does after "press fire") would otherwise wipe the pending
+    // wakeup and the script would never resume.
+    Cycle rshTrigger[3] = { trigger[SLOT_RSH0], trigger[SLOT_RSH1], trigger[SLOT_RSH2] };
+    EventID rshId[3] = { id[SLOT_RSH0], id[SLOT_RSH1], id[SLOT_RSH2] };
+
     serialize(worker);
 
     // Start with a long frame
@@ -139,6 +146,11 @@ Agnus::operator << (SerResetter &worker)
     scheduleFirstBplEvent();
     scheduleFirstDasEvent();
     if (insEvent) scheduleRel <SLOT_INS> (0, insEvent);
+    if (!isHardResetter(worker)) {
+        if (rshTrigger[0] != NEVER) scheduleAbs <SLOT_RSH0> (rshTrigger[0], rshId[0]);
+        if (rshTrigger[1] != NEVER) scheduleAbs <SLOT_RSH1> (rshTrigger[1], rshId[1]);
+        if (rshTrigger[2] != NEVER) scheduleAbs <SLOT_RSH2> (rshTrigger[2], rshId[2]);
+    }
 }
 
 i64
