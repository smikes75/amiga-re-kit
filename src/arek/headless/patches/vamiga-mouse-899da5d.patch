 void
+Mouse::moveBy(long dx, long dy)
+{
+    targetX += (double)dx;
+    targetY += (double)dy;
+    mouseX = targetX;
+    mouseY = targetY;
+    port.setDevice(ControlPortDevice::MOUSE);
+    port.updateMouseXY((i64)targetX, (i64)targetY);
+}
+
+void
+Mouse::setLeftButtonNow(bool value)
+{
+    leftButton.init();
+    leftButton.set(value, agnus.pos.frame);
+    port.setDevice(ControlPortDevice::MOUSE);
+}
+
+void
+Mouse::setRightButtonNow(bool value)
+{
+    rightButton.init();
+    rightButton.set(value, agnus.pos.frame);
+    port.setDevice(ControlPortDevice::MOUSE);
+}
+
