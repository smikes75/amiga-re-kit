diff --git a/Core/Components/Agnus/VahlShots.h b/Core/Components/Agnus/VahlShots.h
new file mode 100644
index 0000000..02d82a4
--- /dev/null
+++ b/Core/Components/Agnus/VahlShots.h
@@ -0,0 +1,34 @@
+// VAHL_SHOTS=<prefix>, VAHL_SHOTS_FRAMES=first:last: the picture of every finished frame in the window as
+// <prefix>_<frame>.raw (RGB24, the same cutout as `screenshot save`), and the emulation goes on - frame
+// exact, unlike `wait 1 frames` + `screenshot save`, which ends the process (amiga-re-kit, arek shot --frames).
+#pragma once
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+namespace vahlshots {
+
+inline bool wanted(long long frame, std::string &path)
+{
+    static bool probed = false;
+    static std::string prefix;
+    static long long first = 0, last = -1;
+    if (!probed) {
+        probed = true;
+        const char *p = std::getenv("VAHL_SHOTS"), *w = std::getenv("VAHL_SHOTS_FRAMES");
+        if (p && w) {
+            prefix = p;
+            first = std::atoll(w);
+            const char *c = std::strchr(w, ':');
+            last = c ? std::atoll(c + 1) : first;
+        }
+    }
+    if (prefix.empty() || frame < first || frame > last) return false;
+    char buf[32];
+    std::snprintf(buf, sizeof buf, "_%06lld.raw", frame);
+    path = prefix + buf;
+    return true;
+}
+
+}
diff --git a/Core/Components/Memory/Memory.cpp b/Core/Components/Memory/Memory.cpp
index 78ee194..92e927f 100644
--- a/Core/Components/Memory/Memory.cpp
+++ b/Core/Components/Memory/Memory.cpp
@@ -2645,12 +2645,36 @@ Memory::spypeekCustom16(u32 addr) const
 // VAHL_REGLOG=<file>: writes to the DMA, interrupt and audio registers (DMACON, INTENA, INTREQ, ADKCON, AUD0-3),
 // 16 B per write: frame, v<<16|h, register<<16|value, PC | source<<24 (0 CPU / 1 Agnus). Recording only.
 static FILE *vahl_reglog = nullptr; static bool vahl_reglog_probed = false;
+// VAHL_REGLOG_REGS=0e0-0f6,08e,090,180-1be: which registers instead (hex offsets, ranges inclusive), e.g. the
+// bitplane pointers and the display window the Copper writes, which spypeek cannot read back.
+static bool vahl_reglog_wants(u32 r)
+{
+    static bool init = false, want[256];
+    if (!init) {
+        init = true;
+        const char *s = getenv("VAHL_REGLOG_REGS");
+        if (!s) {
+            for (u32 x : { 0x096u, 0x09au, 0x09cu, 0x09eu }) want[x >> 1] = true;
+            for (u32 x = 0x0a0; x < 0x0e0; x += 2) want[x >> 1] = true;
+        } else {
+            while (*s) {
+                char *e; u32 a = u32(strtoul(s, &e, 16)), b = a;
+                if (e == s) break;
+                if (*e == '-') { s = e + 1; b = u32(strtoul(s, &e, 16)); }
+                for (u32 x = a & 0x1fe; x <= (b & 0x1fe); x += 2) want[x >> 1] = true;
+                s = *e == ',' ? e + 1 : e;
+                if (e == s && *s) break;
+            }
+        }
+    }
+    return want[(r >> 1) & 255];
+}
