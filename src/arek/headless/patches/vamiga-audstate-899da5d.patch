diff --git a/Core/Components/Agnus/Agnus.h b/Core/Components/Agnus/Agnus.h
index 13d1452..43d3015 100644
--- a/Core/Components/Agnus/Agnus.h
+++ b/Core/Components/Agnus/Agnus.h
@@ -590,6 +590,9 @@ public:
 
     // Transmits a DMA request from Agnus to Paula
     template <int channel> void setAudxDR() { audxDR[channel] = true; }
+    // kit (vamiga-audstate): the audio DMA request flags, for the state dump
+    bool vahlAudxDR(isize channel) const { return audxDR[channel]; }
+    bool vahlAudxDSR(isize channel) const { return audxDSR[channel]; }
     template <int channel> void setAudxDSR() { audxDSR[channel] = true; }
 
