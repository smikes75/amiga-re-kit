diff --git a/Core/Components/Paula/Audio/StateMachine.cpp b/Core/Components/Paula/Audio/StateMachine.cpp
index d4165b6..0c6292e 100644
--- a/Core/Components/Paula/Audio/StateMachine.cpp
+++ b/Core/Components/Paula/Audio/StateMachine.cpp
@@ -32,6 +32,25 @@ StateMachine<nr>::_dump(Category category, std::ostream &os) const
         os << tab("State") << dec(state) << std::endl;
         os << tab("AUDxIP") << bol(AUDxIP()) << std::endl;
         os << tab("AUDxON") << bol(AUDxON()) << std::endl;
+
+        // kit (vamiga-audstate): everything a rebuild's Paula needs to go on from a capture
+        const EventSlot slot = nr == 0 ? SLOT_CH0 : nr == 1 ? SLOT_CH1 : nr == 2 ? SLOT_CH2 : SLOT_CH3;
+        os << tab("audlenLatch") << dec(audlenLatch) << std::endl;
+        os << tab("audlen") << dec(audlen) << std::endl;
+        os << tab("audperLatch") << dec(audperLatch) << std::endl;
+        os << tab("audper") << dec(audper) << std::endl;
+        os << tab("audvolLatch") << dec(audvolLatch) << std::endl;
+        os << tab("audvol") << dec(audvol) << std::endl;
+        os << tab("auddat") << dec(auddat) << std::endl;
+        os << tab("buffer") << dec(buffer) << std::endl;
+        os << tab("intreq2") << bol(intreq2) << std::endl;
+        os << tab("enablePenhi") << bol(enablePenhi) << std::endl;
+        os << tab("enablePenlo") << bol(enablePenlo) << std::endl;
+        os << tab("audxDR") << bol(agnus.vahlAudxDR(nr)) << std::endl;
+        os << tab("audxDSR") << bol(agnus.vahlAudxDSR(nr)) << std::endl;
+        os << tab("audDR") << bol(audDR) << std::endl;   // Paula's own latch: a request raised in this line, handed to Agnus at the line's end
+        os << tab("perfin") << (agnus.trigger[slot] == NEVER ? std::string("never") : std::to_string(agnus.trigger[slot])) << std::endl;
+        os << tab("clock") << std::to_string(agnus.clock) << std::endl;
     }
 }
 
