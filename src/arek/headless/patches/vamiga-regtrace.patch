 namespace vamiga {
 
+// SWIV-projekt patch: viz Memory.cpp
+#define REG_TRACE_MAX 200000
+struct RegTraceEntry {
+    u16 reg;      // offset registru (0x000..0x1FE)
+    u16 value;    // zapsana hodnota
+    u32 pc;       // PC instrukce, ktera zapis provedla
+    u8  agnus;    // 1 = zapis provedl Agnus (copper), 0 = CPU
+    u16 vpos;     // rastrova pozice v okamziku zapisu
+    u16 hpos;
+};
+extern bool regTraceOn;
+extern u32  regTraceCount;
+extern RegTraceEntry regTrace[REG_TRACE_MAX];
